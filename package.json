{
  "name": "vendotube-studio",
  "productName": "VendoTube Studio",
  "version": "2.0.0",
  "description": "Multi-agent documentary studio — one brief, one crew, one film",
  "author": "Vendoria",
  "repository": {
    "type": "git",
    "url": "https://github.com/vendoriaai/VendoTube-Studio"
  },
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "smoke": "cross-env VENDOTUBE_SMOKE=1 electron .",
    "dist": "electron-vite build && electron-builder --dir",
    "rebuild:electron": "cd node_modules/better-sqlite3 && npx prebuild-install -r electron -t 33.4.11",
    "postinstall": "npm run -s rebuild:electron || echo \"(prebuild for electron unavailable — run npm run rebuild:electron)\"",
    "setup:bridge": "python -m venv bridge/.venv && bridge/.venv/Scripts/python -m pip install --upgrade pip && bridge/.venv/Scripts/python -m pip install -r bridge/requirements.txt"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/jetbrains-mono": "^5.1.0",
    "@fontsource-variable/space-grotesk": "^5.1.0",
    "@supabase/supabase-js": "^2.119.2",
    "better-sqlite3": "^11.10.0",
    "gsap": "^3.15.1",
    "hyperframes": "^0.9.39",
    "playwright-core": "^1.65.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.23.0",
    "yaml": "^2.6.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.0",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^2.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
